import { AboutSlint, ScrollView } from "std-widgets.slint";
import "../assets/fonts/NotoSansJP.ttf";

export struct MissedItem {
    name: string,
    capital: string,
    flag: image,
}

export struct HistoryItem {
    timestamp: string,
    outcome: string,
    countries: string,
    details: string,
}

export global SoundEvents {
    callback tap();
}

export global AtlasColors {
    out property <color> canvas: #edf3f1;
    out property <color> paper: #ffffff;
    out property <color> ink: #173a45;
    out property <color> muted: #61777b;
    out property <color> line: #d6e2df;
    out property <color> accent: #e65c43;
    out property <color> sea: #c8e3df;
    out property <color> correct: #d9eee3;
    out property <color> incorrect: #f8ded8;
}

component PrivateFlagImage inherits Rectangle {
    in property <image> source;

    background: transparent;

    if root.source.width > 0 && root.source.height > 0: Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: min(root.width, root.height * (root.source.width / root.source.height));
        height: min(root.height, root.width * (root.source.height / root.source.width));
        border-width: 1px;
        border-color: AtlasColors.line;
        background: AtlasColors.canvas;

        Image {
            source: root.source;
            x: 1px;
            y: 1px;
            width: max(parent.width - 2px, 0px);
            height: max(parent.height - 2px, 0px);
            image-fit: contain;
        }
    }
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <string> accessible-name: root.label;
    in property <bool> enabled: true;
    callback tapped();

    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            SoundEvents.tap();
            root.tapped();
        }
    }
    height: 58px;
    border-radius: 17px;
    background: root.enabled ? AtlasColors.accent : #cbd7d4;

    Text {
        text: root.label;
        color: root.enabled ? #ffffff : #718285;
        font-size: 17px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    TouchArea {
        clicked => {
            if (root.enabled) {
                SoundEvents.tap();
                root.tapped();
            }
        }
    }
}

component BackButton inherits Rectangle {
    callback tapped();
    in property <string> label: "ホーム";

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        SoundEvents.tap();
        root.tapped();
    }
    width: 88px;
    height: 36px;
    background: transparent;

    HorizontalLayout {
        spacing: 8px;

        Text {
            text: "‹";
            color: AtlasColors.accent;
            font-size: 27px;
            vertical-alignment: center;
        }

        Text {
            text: root.label;
            color: AtlasColors.muted;
            font-size: 14px;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => {
            SoundEvents.tap();
            root.tapped();
        }
    }
}


component OptionTile inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <length> tile-height: 52px;
    callback tapped();

    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => {
        SoundEvents.tap();
        root.tapped();
    }
    height: root.tile-height;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.selected ? AtlasColors.ink : AtlasColors.line;
    background: root.selected ? AtlasColors.ink : AtlasColors.paper;

    Text {
        text: root.label;
        color: root.selected ? #ffffff : AtlasColors.ink;
        font-size: 15px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    TouchArea {
        clicked => {
            SoundEvents.tap();
            root.tapped();
        }
    }
}

component AnswerTile inherits Rectangle {
    in property <string> label;
    in property <int> choice-index;
    in property <int> selected-index: -1;
    in property <int> correct-index: -1;
    in property <bool> answered: false;
    in property <bool> enabled: true;
    in property <length> tile-height: 52px;
    callback tapped(int);

    accessible-role: button;
    accessible-label: "選択肢 \{root.choice-index + 1}: \{root.label}";
    accessible-description: root.answered
        ? (root.choice-index == root.correct-index ? "正解" : "不正解")
        : "";
    accessible-enabled: root.enabled && !root.answered;
    accessible-action-default => {
        if (root.enabled && !root.answered) {
            root.tapped(root.choice-index);
        }
    }
    height: root.tile-height;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.answered && root.choice-index == root.correct-index ? #72ae8b
        : root.answered && root.choice-index == root.selected-index ? #da8a79
        : AtlasColors.line;
    background: root.answered && root.choice-index == root.correct-index ? AtlasColors.correct
        : root.answered && root.choice-index == root.selected-index ? AtlasColors.incorrect
        : AtlasColors.paper;

    Text {
        text: root.label;
        color: AtlasColors.ink;
        font-size: 15px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
        width: 100%;
        height: 100%;
    }

    TouchArea {
        clicked => {
            if (root.enabled && !root.answered) {
                root.tapped(root.choice-index);
            }
        }
    }
}

component QuizAnswerChoices inherits Rectangle {
    in property <[string]> choices;
    in property <int> selected-index: -1;
    in property <int> correct-index: -1;
    in property <bool> answered: false;
    in property <bool> enabled: true;
    in property <length> tile-height: 52px;
    callback answer(int);

    height: root.choices.length * root.tile-height
        + max(root.choices.length - 1, 0) * 8px;

    VerticalLayout {
        spacing: 8px;
        for choice[index] in root.choices: AnswerTile {
            label: choice;
            choice-index: index;
            selected-index: root.selected-index;
            correct-index: root.correct-index;
            answered: root.answered;
            enabled: root.enabled;
            tile-height: root.tile-height;
            tapped(index) => { root.answer(index); }
        }
    }
}

component MapControlButton inherits Rectangle {
    in property <string> label;
    in property <string> glyph;
    in property <bool> enabled: true;
    callback tapped();

    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            SoundEvents.tap();
            root.tapped();
        }
    }
    width: 48px;
    height: 44px;
    border-radius: 12px;
    border-width: 1px;
    border-color: AtlasColors.line;
    background: root.enabled ? AtlasColors.paper : #edf3f1;

    Text {
        text: root.glyph;
        color: root.enabled ? AtlasColors.ink : AtlasColors.muted;
        font-size: root.glyph == "戻す" ? 12px : 22px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        width: 100%;
        height: 100%;
    }

    TouchArea {
        clicked => {
            if (root.enabled) {
                SoundEvents.tap();
                root.tapped();
            }
        }
    }
}

component MapViewer inherits Rectangle {
    in property <image> map-image;
    in property <int> question-number;
    in property <bool> enabled: true;

    private property <int> zoom-percent: 100;
    private property <length> map-size:
        min(root.width, max(root.height - 52px, 0px));
    private property <length> previous-map-size;
    private property <int> max-zoom-percent:
        root.map-size * 300 / 100 <= 1600px ? 300
        : root.map-size * 250 / 100 <= 1600px ? 250
        : root.map-size * 200 / 100 <= 1600px ? 200
        : root.map-size * 150 / 100 <= 1600px ? 150
        : 100;

    init => {
        root.previous-map-size = root.map-size;
    }

    function zoom-to(next: int) {
        let target = min(max(next, 100), root.max-zoom-percent);
        map-flickable.content-x = (map-flickable.content-x - map-flickable.width / 2)
            * target / root.zoom-percent + map-flickable.width / 2;
        map-flickable.content-y = (map-flickable.content-y - map-flickable.height / 2)
            * target / root.zoom-percent + map-flickable.height / 2;
        root.zoom-percent = target;
    }

    border-radius: 20px;
    min-width: 0px;
    min-height: 0px;
    background: AtlasColors.paper;
    clip: true;

    map-flickable := Flickable {
        x: (root.width - root.map-size) / 2;
        y: 52px + (root.height - 52px - root.map-size) / 2;
        width: root.map-size;
        height: root.map-size;
        content-width: map-flickable.width * root.zoom-percent / 100;
        content-height: map-flickable.height * root.zoom-percent / 100;
        interactive: root.enabled;
        mouse-drag-pan-enabled: root.enabled;
        accessible-role: image;
        accessible-label: "地図の表示領域";
        accessible-description: "倍率 \{root.zoom-percent}％。地図をドラッグして移動できます。";

        if root.map-image.width == 0: Text {
            text: "地図を読み込みます";
            color: AtlasColors.muted;
            font-size: 13px;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }

        map-image-element := Image {
            x: 0px;
            y: 0px;
            source: root.map-image;
            width: map-flickable.content-width;
            height: map-flickable.content-height;
            image-fit: contain;
        }
    }

    HorizontalLayout {
        x: root.width - 160px;
        y: 4px;
        width: 152px;
        height: 44px;
        spacing: 4px;

        MapControlButton {
            label: "地図を拡大";
            glyph: "＋";
            enabled: root.enabled && root.zoom-percent < root.max-zoom-percent;
            tapped => { root.zoom-to(root.zoom-percent + 50); }
        }

        MapControlButton {
            label: "地図を縮小";
            glyph: "−";
            enabled: root.enabled && root.zoom-percent > 100;
            tapped => { root.zoom-to(root.zoom-percent - 50); }
        }

        MapControlButton {
            label: "地図をリセット";
            glyph: "戻す";
            enabled: root.enabled && (root.zoom-percent != 100
                || map-flickable.content-x != 0px
                || map-flickable.content-y != 0px);
            tapped => {
                root.zoom-percent = 100;
                map-flickable.content-x = 0px;
                map-flickable.content-y = 0px;
            }
        }
    }

    changed map-size => {
        let target = min(root.zoom-percent, root.max-zoom-percent);
        if (root.previous-map-size > 0px) {
            let scale = root.map-size / root.previous-map-size * target / root.zoom-percent;
            map-flickable.content-x = (map-flickable.content-x - root.previous-map-size / 2)
                * scale + root.map-size / 2;
            map-flickable.content-y = (map-flickable.content-y - root.previous-map-size / 2)
                * scale + root.map-size / 2;
        } else {
            map-flickable.content-x = 0px;
            map-flickable.content-y = 0px;
        }
        root.zoom-percent = target;
        root.previous-map-size = root.map-size;
    }

    changed question-number => {
        root.zoom-percent = 100;
        map-flickable.content-x = 0px;
        map-flickable.content-y = 0px;
    }
}

component MapQuizBody inherits Rectangle {
    in property <image> map-image;
    in property <int> question-number;
    in property <[string]> choices;
    in property <int> selected-index: -1;
    in property <int> correct-index: -1;
    in property <bool> answered: false;
    in property <bool> enabled: true;
    in property <bool> wide-layout: false;
    callback answer(int);
    callback next-question();

    private property <length> choice-height:
        root.choices.length * 48px + max(root.choices.length - 1, 0) * 8px;
    private property <length> map-width: root.wide-layout
        ? max(root.width - 312px, 0px)
        : root.width;
    private property <length> map-height: root.wide-layout
        ? root.height
        : max(root.height - root.choice-height - 14px - 58px, 0px);
    private property <length> choices-x: root.wide-layout ? root.width - 300px : 0px;
    private property <length> choices-y: root.wide-layout ? 0px : root.map-height + 14px;
    private property <length> next-y: root.wide-layout
        ? root.choice-height + 12px
        : root.choices-y + root.choice-height;

    min-width: 0px;
    min-height: 0px;
    clip: true;

    MapViewer {
        x: 0px;
        y: 0px;
        width: root.map-width;
        height: root.map-height;
        map-image: root.map-image;
        question-number: root.question-number;
        enabled: root.enabled;
    }

    QuizAnswerChoices {
        x: root.choices-x;
        y: root.choices-y;
        width: root.wide-layout ? 300px : root.width;
        height: root.choice-height;
        choices: root.choices;
        selected-index: root.selected-index;
        correct-index: root.correct-index;
        answered: root.answered;
        enabled: root.enabled;
        tile-height: 48px;
        answer(index) => { root.answer(index); }
    }

    if root.answered: ActionButton {
        x: root.wide-layout ? root.width - 300px : 0px;
        y: root.next-y;
        width: root.wide-layout ? 300px : root.width;
        height: 58px;
        label: "次の問題へ";
        enabled: root.enabled;
        tapped => { root.next-question(); }
    }
}

component MissedRow inherits Rectangle {
    in property <MissedItem> item;

    height: 64px;
    border-radius: 14px;
    background: AtlasColors.paper;

    HorizontalLayout {
        padding: 10px;
        spacing: 12px;

        PrivateFlagImage {
            source: root.item.flag;
            width: 48px;
            height: 34px;
        }

        VerticalLayout {
            alignment: center;
            spacing: 2px;

            Text {
                text: root.item.name;
                overflow: elide;
                color: AtlasColors.ink;
                font-size: 15px;
                font-weight: 700;
            }

            Text {
                text: "首都：\{root.item.capital}";
                overflow: elide;
                color: AtlasColors.muted;
                font-size: 12px;
            }
        }
    }
}

component HistoryRow inherits Rectangle {
    in property <HistoryItem> item;

    height: 128px;
    border-radius: 14px;
    background: AtlasColors.paper;

    VerticalLayout {
        padding: 12px;
        spacing: 4px;

        Text {
            text: root.item.timestamp;
            color: AtlasColors.muted;
            font-size: 11px;
        }

        Text {
            text: root.item.outcome;
            color: AtlasColors.ink;
            font-size: 14px;
            font-weight: 700;
        }

        Text {
            text: root.item.countries;
            color: AtlasColors.ink;
            font-size: 12px;
            wrap: word-wrap;
        }

        Text {
            text: root.item.details;
            color: AtlasColors.muted;
            font-size: 11px;
            wrap: word-wrap;
        }
    }
}

export component AppWindow inherits Window {
    in-out property <string> screen: "home";
    in property <int> review-count;
    in property <string> privacy-text: "";
    in property <string> flag-license-text: "";
    in property <string> font-license-text: "";
    callback start-round(int, int);
    callback start-review();
    in property <int> question-number;
    in property <int> total-questions;
    in property <int> score;
    in property <string> kind;
    in property <image> question-image;
    in property <[string]> hints;
    in property <bool> can-reveal-hint;
    in property <[string]> choices;
    in property <bool> answered;
    in property <int> selected-index: -1;
    in property <int> correct-index: -1;
    callback answer(int);
    callback reveal-hint();
    callback next-question();
    in property <int> result-correct;
    in property <int> result-score;
    in property <[MissedItem]> missed;
    callback go-home();

    in property <[HistoryItem]> history-items;
    in property <bool> history-empty;
    in property <bool> history-unreadable;
    in property <bool> history-has-older;
    in property <bool> history-has-newer;
    in property <string> history-page-label;
    in property <string> storage-warning: "";
    callback open-history();
    callback history-older();
    callback history-newer();
    in-out property <bool> quit-confirmation-open: false;

    private property <int> chosen-mode: 0;
    private property <int> chosen-region: 0;
    private property <bool> wide-map-layout:
        root.width - root.safe-area-insets.left - root.safe-area-insets.right >= 760px
        && root.width - root.safe-area-insets.left - root.safe-area-insets.right
        > root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;

    preferred-width: 390px;
    preferred-height: 844px;
    min-width: 320px;
    background: AtlasColors.canvas;
    default-font-family: "Noto Sans JP";
    title: "国あんき";

    Rectangle {
        x: root.safe-area-insets.left;
        y: root.safe-area-insets.top;
        width: root.width - root.safe-area-insets.left - root.safe-area-insets.right;
        height: root.height - root.safe-area-insets.top - root.safe-area-insets.bottom;
        clip: true;

        if root.screen == "home": VerticalLayout {
            padding: 22px;
            spacing: 0px;

            HorizontalLayout {
                height: 38px;
                spacing: 8px;

                Text {
                    text: "国あんき";
                    color: AtlasColors.ink;
                    font-size: 18px;
                    font-weight: 800;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                Text {
                    text: "193か国";
                    color: AtlasColors.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }

            // Shrinks the hero first so the actions and footer stay on short screens.
            Rectangle {
                min-height: 0px;
                preferred-height: home-hero-content.preferred-height;
                max-height: home-hero-content.preferred-height;
                vertical-stretch: 1;

                Flickable {
                    content-height: home-hero-content.preferred-height;

                    home-hero-content := VerticalLayout {
                        width: parent.width;
                        padding-top: 24px;
                        spacing: 0px;

                        Text {
                            text: "世界のかたちを、\n国から知る。";
                            color: AtlasColors.ink;
                            font-size: 27px;
                            font-weight: 700;
                            line-height-factor: 1.25;
                        }

                        Rectangle {
                            height: 16px;
                            background: transparent;
                        }

                        Rectangle {
                            height: 254px;
                            border-radius: 25px;
                            background: AtlasColors.ink;
                            clip: true;

                            Rectangle {
                                x: 232px;
                                y: -32px;
                                width: 190px;
                                height: 190px;
                                border-radius: 95px;
                                border-width: 1px;
                                border-color: #66838a;
                                background: transparent;
                            }

                            Rectangle {
                                x: 273px;
                                y: 10px;
                                width: 108px;
                                height: 108px;
                                border-radius: 54px;
                                border-width: 1px;
                                border-color: #66838a;
                                background: transparent;
                            }

                            Rectangle {
                                x: 315px;
                                y: 51px;
                                width: 24px;
                                height: 24px;
                                border-radius: 12px;
                                background: AtlasColors.accent;
                            }

                            VerticalLayout {
                                padding: 22px;
                                spacing: 0px;

                                Text {
                                    text: "旗・地図・3つのヒント";
                                    color: AtlasColors.sea;
                                    font-size: 13px;
                                    font-weight: 600;
                                }

                                Rectangle {
                                    height: 12px;
                                    background: transparent;
                                }

                                Text {
                                    text: "見つけて、\n覚えていく。";
                                    color: #ffffff;
                                    font-size: 25px;
                                    font-weight: 700;
                                    line-height-factor: 1.2;
                                }

                                Rectangle {
                                    height: 12px;
                                    background: transparent;
                                }

                                Rectangle {
                                    width: 34px;
                                    height: 4px;
                                    border-radius: 2px;
                                    background: AtlasColors.accent;
                                }

                                Rectangle {
                                    vertical-stretch: 1;
                                    background: transparent;
                                }

                                HorizontalLayout {
                                    spacing: 10px;

                                    Text {
                                        text: "193";
                                        color: #ffffff;
                                        font-size: 30px;
                                        font-weight: 800;
                                    }

                                    Text {
                                        text: "か国をめぐる、10問の旅";
                                        color: AtlasColors.sea;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 22px;
                background: transparent;
            }

            ActionButton {
                label: "クイズを始める";
                tapped => {
                    root.screen = "select";
                }
            }

            Rectangle {
                height: 10px;
                background: transparent;
            }

            Rectangle {
                accessible-role: button;
                accessible-label: "まちがえた国を復習、\{root.review-count}問";
                accessible-enabled: root.review-count > 0;
                accessible-action-default => {
                    if (root.review-count > 0) {
                        SoundEvents.tap();
                        root.start-review();
                    }
                }
                height: 62px;
                border-radius: 16px;
                border-width: 1px;
                border-color: AtlasColors.line;
                background: root.review-count > 0 ? AtlasColors.paper : #e4ece9;

                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    spacing: 8px;

                    Text {
                        text: "まちがえた国を復習";
                        color: root.review-count > 0 ? AtlasColors.ink : AtlasColors.muted;
                        font-size: 14px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }

                    Text {
                        text: "\{root.review-count}";
                        color: root.review-count > 0 ? AtlasColors.accent : AtlasColors.muted;
                        font-size: 17px;
                        font-weight: 800;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "問";
                        color: AtlasColors.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    clicked => {
                        if (root.review-count > 0) {
                            SoundEvents.tap();
                            root.start-review();
                        }
                    }
                }
            }

            if root.storage-warning != "": Text {
                text: root.storage-warning;
                color: AtlasColors.accent;
                font-size: 11px;
                wrap: word-wrap;
            }
            Rectangle {
                vertical-stretch: 1;
                background: transparent;
            }

            HorizontalLayout {
                height: 42px;
                spacing: 8px;

                Rectangle {
                    accessible-role: button;
                    accessible-label: "回答履歴を見る";
                    accessible-action-default => {
                        SoundEvents.tap();
                        root.open-history();
                    }
                    horizontal-stretch: 1;
                    height: 42px;
                    background: transparent;

                    Text {
                        text: "回答履歴";
                        color: AtlasColors.muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }

                    TouchArea {
                        clicked => {
                            SoundEvents.tap();
                            root.open-history();
                        }
                    }
                }

                Rectangle {
                    accessible-role: button;
                    accessible-label: "このアプリについて";
                    accessible-action-default => {
                        SoundEvents.tap();
                        root.screen = "about";
                    }
                    horizontal-stretch: 1;
                    height: 42px;
                    background: transparent;

                    Text {
                        text: "このアプリについて";
                        color: AtlasColors.muted;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }

                    TouchArea {
                        clicked => {
                            SoundEvents.tap();
                            root.screen = "about";
                        }
                    }
                }
            }
        }

        if root.screen == "select": VerticalLayout {
            padding: 20px;
            spacing: 0px;

            HorizontalLayout {
                height: 36px;

                BackButton {
                    tapped => { root.screen = "home"; }
                }
            }

            Rectangle {
                height: 12px;
                background: transparent;
            }

            select-options := ScrollView {
                vertical-stretch: 1;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                mouse-drag-pan-enabled: true;

                VerticalLayout {
                    width: select-options.visible-width;
                    alignment: start;
                    padding-top: 10px;
                    padding-bottom: 12px;
                    spacing: 0px;

                    Text {
                        text: "どんな方法で覚える？";
                        color: AtlasColors.ink;
                        font-size: 23px;
                        font-weight: 700;
                    }

                    Rectangle {
                        height: 6px;
                        background: transparent;
                    }

                    Text {
                        text: "出題方法と地域を選んでください";
                        color: AtlasColors.muted;
                        font-size: 13px;
                    }

                    Rectangle {
                        height: 22px;
                        background: transparent;
                    }

                    Text {
                        text: "出題方法";
                        color: AtlasColors.ink;
                        font-size: 15px;
                        font-weight: 700;
                    }

                    Rectangle {
                        height: 10px;
                        background: transparent;
                    }

                    GridLayout {
                        spacing: 8px;

                        Row {
                            OptionTile {
                                label: "国旗";
                                selected: root.chosen-mode == 0;
                                tile-height: 54px;
                                tapped => { root.chosen-mode = 0; }
                            }

                            OptionTile {
                                label: "地図";
                                selected: root.chosen-mode == 1;
                                tile-height: 54px;
                                tapped => { root.chosen-mode = 1; }
                            }
                        }

                        Row {
                            OptionTile {
                                label: "3ヒント";
                                selected: root.chosen-mode == 2;
                                tile-height: 54px;
                                tapped => { root.chosen-mode = 2; }
                            }

                            OptionTile {
                                label: "おまかせ";
                                selected: root.chosen-mode == 3;
                                tile-height: 54px;
                                tapped => { root.chosen-mode = 3; }
                            }
                        }
                    }

                    Rectangle {
                        height: 20px;
                        background: transparent;
                    }

                    Text {
                        text: "地域";
                        color: AtlasColors.ink;
                        font-size: 15px;
                        font-weight: 700;
                    }

                    Rectangle {
                        height: 10px;
                        background: transparent;
                    }

                    GridLayout {
                        spacing: 8px;

                        Row {
                            OptionTile {
                                label: "全地域";
                                selected: root.chosen-region == 0;
                                tile-height: 42px;
                                tapped => { root.chosen-region = 0; }
                            }

                            OptionTile {
                                label: "アジア";
                                selected: root.chosen-region == 1;
                                tile-height: 42px;
                                tapped => { root.chosen-region = 1; }
                            }
                        }

                        Row {
                            OptionTile {
                                label: "ヨーロッパ";
                                selected: root.chosen-region == 2;
                                tile-height: 42px;
                                tapped => { root.chosen-region = 2; }
                            }

                            OptionTile {
                                label: "アフリカ";
                                selected: root.chosen-region == 3;
                                tile-height: 42px;
                                tapped => { root.chosen-region = 3; }
                            }
                        }

                        Row {
                            OptionTile {
                                label: "北米・中米";
                                selected: root.chosen-region == 4;
                                tile-height: 42px;
                                tapped => { root.chosen-region = 4; }
                            }

                            OptionTile {
                                label: "南米";
                                selected: root.chosen-region == 5;
                                tile-height: 42px;
                                tapped => { root.chosen-region = 5; }
                            }
                        }

                        Row {
                            OptionTile {
                                label: "オセアニア";
                                selected: root.chosen-region == 6;
                                tile-height: 42px;
                                tapped => { root.chosen-region = 6; }
                            }
                        }
                    }
                }
            }

            Rectangle {
                height: 8px;
                background: transparent;
            }

            ActionButton {
                label: "10問を始める";
                tapped => {
                    root.start-round(root.chosen-mode, root.chosen-region);
                }
            }
        }

        if root.screen == "quiz": VerticalLayout {
            padding: root.kind == "map" ? 12px : 20px;
            spacing: 0px;

            HorizontalLayout {
                height: 48px;
                spacing: 8px;

                Text {
                    text: "第 \{root.question-number} 問";
                    color: AtlasColors.ink;
                    font-size: 16px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                Rectangle {
                    horizontal-stretch: 1;
                    background: transparent;
                }

                Text {
                    text: "得点  \{root.score}";
                    color: AtlasColors.muted;
                    font-size: 13px;
                    font-weight: 600;
                    vertical-alignment: center;
                }

                Rectangle {
                    width: 68px;
                    height: 48px;
                    border-radius: 12px;
                    background: AtlasColors.paper;
                    accessible-role: button;
                    accessible-label: "クイズを中断";
                    accessible-action-default => {
                        SoundEvents.tap();
                        root.quit-confirmation-open = true;
                    }

                    Text {
                        text: "中断";
                        color: AtlasColors.accent;
                        font-size: 13px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: 100%;
                        height: 100%;
                    }

                    TouchArea {
                        clicked => {
                            SoundEvents.tap();
                            root.quit-confirmation-open = true;
                        }
                    }
                }
            }

            Rectangle {
                height: root.kind == "map" ? 4px : 8px;
                background: transparent;
            }

            Rectangle {
                height: 5px;
                border-radius: 3px;
                background: AtlasColors.line;

                Rectangle {
                    width: root.total-questions > 0
                        ? parent.width * root.question-number / root.total-questions
                        : 0px;
                    height: 100%;
                    border-radius: 3px;
                    background: AtlasColors.accent;
                }
            }

            Rectangle {
                height: root.kind == "map" ? 8px : 20px;
                background: transparent;
            }

            Text {
                text: root.kind == "trivia" ? "ヒントから国を当てよう" : (root.kind == "map" ? "地図を見て答えよう" : "国旗を見て答えよう");
                color: AtlasColors.ink;
                font-size: 19px;
                font-weight: 700;
            }

            Rectangle {
                height: root.kind == "map" ? 8px : 12px;
                background: transparent;
            }

            if root.kind == "trivia": ScrollView {
                min-height: root.hints.length > 2 ? 178px : (root.hints.length == 2 ? 114px : 54px);
                vertical-stretch: 1;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                mouse-drag-pan-enabled: true;

                VerticalLayout {
                    alignment: start;
                    spacing: 8px;

                    for hint[index] in root.hints: Rectangle {
                        min-height: hint-text.preferred-height + 24px;
                        border-radius: 14px;
                        background: AtlasColors.paper;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 12px;

                            Text {
                                text: "ヒント \{index + 1}";
                                color: AtlasColors.accent;
                                font-size: 12px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            hint-text := Text {
                                text: hint;
                                color: AtlasColors.ink;
                                font-size: 13px;
                                vertical-alignment: center;
                                wrap: word-wrap;
                                horizontal-stretch: 1;
                            }
                        }
                    }

                    if root.hints.length == 0: Text {
                        text: "ヒントがここに表示されます";
                        color: AtlasColors.muted;
                        font-size: 13px;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }

            if root.kind == "flag": Rectangle {
                height: 178px;
                border-radius: 20px;
                background: AtlasColors.paper;
                if root.question-image.width == 0: Text {
                    text: "国旗を読み込みます";
                    color: AtlasColors.muted;
                    font-size: 13px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    width: 100%;
                    height: 100%;
                }
                PrivateFlagImage {
                    source: root.question-image;
                    width: 100%;
                    height: 100%;
                }
            }

            if root.kind == "map": MapQuizBody {
                map-image: root.question-image;
                question-number: root.question-number;
                choices: root.choices;
                selected-index: root.selected-index;
                correct-index: root.correct-index;
                answered: root.answered;
                enabled: !root.quit-confirmation-open;
                wide-layout: root.wide-map-layout;
                vertical-stretch: 1;
                answer(index) => { root.answer(index); }
                next-question => { root.next-question(); }
            }

            if root.kind != "map": Rectangle {
                height: 14px;
                background: transparent;
            }
            if root.kind == "trivia" && !root.answered: ActionButton {
                accessible-name: "次のヒントを見る";
                label: root.can-reveal-hint ? "次のヒントを見る" : "ヒントをすべて表示済み";
                enabled: root.can-reveal-hint && !root.answered && !root.quit-confirmation-open;
                height: 48px;
                tapped => { root.reveal-hint(); }
            }

            if root.kind == "trivia" && !root.answered: Rectangle {
                height: 12px;
                background: transparent;
            }

            if root.kind != "map": QuizAnswerChoices {
                choices: root.choices;
                selected-index: root.selected-index;
                correct-index: root.correct-index;
                answered: root.answered;
                enabled: !root.quit-confirmation-open;
                answer(index) => { root.answer(index); }
            }

            if root.kind != "map": Rectangle {
                min-height: root.kind == "trivia" ? 16px : 0px;
                vertical-stretch: root.kind == "trivia" ? 0 : 1;
                background: transparent;
            }

            if root.kind != "map" && root.answered: ActionButton {
                label: "次の問題へ";
                enabled: !root.quit-confirmation-open;
                tapped => { root.next-question(); }
            }
            if root.storage-warning != "": Text {
                text: root.storage-warning;
                color: AtlasColors.accent;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
        if root.screen == "quiz" && root.quit-confirmation-open: Rectangle {
            x: 0;
            y: 0;
            width: parent.width;
            height: parent.height;
            background: transparent;

            Rectangle {
                width: 100%;
                height: 100%;
                background: AtlasColors.ink;
                opacity: 0.56;

                TouchArea {
                    clicked => {}
                }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: parent.width < 392px ? parent.width - 32px : 360px;
                height: 270px;
                border-radius: 20px;
                background: AtlasColors.paper;

                VerticalLayout {
                    padding: 20px;
                    spacing: 10px;

                    Text {
                        text: "クイズを中断しますか？";
                        color: AtlasColors.ink;
                        font-size: 20px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "回答済みの記録は残ります。";
                        color: AtlasColors.muted;
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        height: 4px;
                        background: transparent;
                    }

                    ActionButton {
                        label: "続ける";
                        height: 52px;
                        tapped => {
                            root.quit-confirmation-open = false;
                        }
                    }

                    ActionButton {
                        label: "ホームへ戻る";
                        height: 52px;
                        tapped => { root.go-home(); }
                    }
                }
            }
        }

        if root.screen == "history": VerticalLayout {
            padding: 20px;
            spacing: 0px;

            HorizontalLayout {
                height: 36px;

                BackButton {
                    tapped => { root.go-home(); }
                }
            }

            Rectangle {
                height: 20px;
                background: transparent;
            }

            Text {
                text: "回答履歴";
                color: AtlasColors.ink;
                font-size: 23px;
                font-weight: 700;
            }

            Rectangle {
                height: 6px;
                background: transparent;
            }

            Text {
                text: "新しい回答から順に表示します";
                color: AtlasColors.muted;
                font-size: 13px;
            }

            if root.storage-warning != "": Text {
                text: root.storage-warning;
                color: AtlasColors.accent;
                font-size: 11px;
                wrap: word-wrap;
            }

            Rectangle {
                height: 12px;
                background: transparent;
            }

            if root.history-empty && !root.history-unreadable: Text {
                text: "まだ回答履歴はありません。\nクイズに答えると、ここに記録されます。";
                color: AtlasColors.muted;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
                height: 160px;
                width: 100%;
                wrap: word-wrap;
            }

            if root.history-empty && root.history-unreadable: Text {
                text: "履歴を表示できませんでした（元データは保持しています）";
                color: AtlasColors.accent;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
                height: 160px;
                width: 100%;
                wrap: word-wrap;
            }

            if root.history-empty: Rectangle {
                vertical-stretch: 1;
                background: transparent;
            }

            if !root.history-empty: ScrollView {
                vertical-stretch: 1;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                mouse-drag-pan-enabled: true;

                VerticalLayout {
                    spacing: 8px;
                    for item in root.history-items: HistoryRow {
                        item: item;
                    }
                }
            }

            if !root.history-empty: HorizontalLayout {
                height: 50px;
                spacing: 8px;

                ActionButton {
                    width: 112px;
                    height: 48px;
                    label: "新しい記録";
                    enabled: root.history-has-newer;
                    tapped => { root.history-newer(); }
                }

                Text {
                    text: root.history-page-label;
                    horizontal-stretch: 1;
                    color: AtlasColors.muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                ActionButton {
                    width: 112px;
                    height: 48px;
                    label: "古い記録";
                    enabled: root.history-has-older;
                    tapped => { root.history-older(); }
                }
            }
        }

        if root.screen == "result": VerticalLayout {
            padding: 22px;
            spacing: 0px;

            Text {
                text: "今回の結果";
                color: AtlasColors.ink;
                font-size: 23px;
                font-weight: 700;
            }

            Rectangle {
                height: 18px;
                background: transparent;
            }

            Rectangle {
                height: 164px;
                border-radius: 24px;
                background: AtlasColors.ink;

                HorizontalLayout {
                    padding: 22px;
                    spacing: 12px;

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;

                        Text {
                            text: "正解";
                            color: AtlasColors.sea;
                            font-size: 13px;
                        }

                        Text {
                            text: "\{root.result-correct} / \{root.total-questions}";
                            color: #ffffff;
                            font-size: 37px;
                            font-weight: 800;
                        }
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                    }

                    VerticalLayout {
                        alignment: center;

                        Text {
                            text: "\{root.result-score}";
                            color: AtlasColors.accent;
                            font-size: 38px;
                            font-weight: 800;
                            horizontal-alignment: right;
                        }

                        Text {
                            text: "ポイント";
                            color: AtlasColors.sea;
                            font-size: 12px;
                            horizontal-alignment: right;
                        }
                    }
                }
            }

            Rectangle {
                height: 20px;
                background: transparent;
            }

            Text {
                text: root.missed.length > 0 ? "もう一度覚えたい国" : "全問正解です。すばらしい！";
                color: AtlasColors.ink;
                font-size: 16px;
                font-weight: 700;
            }

            Rectangle {
                height: 10px;
                background: transparent;
            }

            if root.missed.length > 0: ScrollView {
                vertical-stretch: 1;
                mouse-drag-pan-enabled: true;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;

                VerticalLayout {
                    spacing: 8px;
                    for item in root.missed: MissedRow {
                        item: item;
                    }
                }
            }

            if root.storage-warning != "": Text {
                text: root.storage-warning;
                color: AtlasColors.accent;
                font-size: 11px;
                wrap: word-wrap;
            }
            Rectangle {
                min-height: 16px;
                vertical-stretch: root.missed.length > 0 ? 0 : 1;
                background: transparent;
            }

            ActionButton {
                label: "ホームへ戻る";
                tapped => { root.go-home(); }
            }
        }

        if root.screen == "about": VerticalLayout {
            padding: 22px;
            spacing: 0px;

            HorizontalLayout {
                height: 36px;

                BackButton {
                    tapped => { root.screen = "home"; }
                }
            }

            Rectangle {
                height: 24px;
                background: transparent;
            }

            Text {
                text: "このアプリについて";
                color: AtlasColors.ink;
                font-size: 23px;
                font-weight: 700;
            }

            Rectangle {
                height: 10px;
                background: transparent;
            }

            Text {
                text: "世界の国を、旗と地図と豆知識で。";
                color: AtlasColors.muted;
                font-size: 14px;
            }

            Rectangle {
                height: 28px;
                background: transparent;
            }

            Text {
                text: "データと素材";
                color: AtlasColors.ink;
                font-size: 16px;
                font-weight: 700;
            }

            Rectangle {
                height: 10px;
                background: transparent;
            }

            Rectangle {
                height: 224px;
                border-radius: 18px;
                background: AtlasColors.paper;

                VerticalLayout {
                    padding: 16px;
                    spacing: 0px;

                    HorizontalLayout {
                        height: 42px;

                        Text {
                            text: "国のデータ";
                            color: AtlasColors.ink;
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }

                        Text {
                            text: "Wikidata · CC0";
                            color: AtlasColors.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: AtlasColors.line;
                    }

                    HorizontalLayout {
                        height: 42px;

                        Text {
                            text: "国旗";
                            color: AtlasColors.ink;
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }

                        Text {
                            text: "flag-icons · MIT";
                            color: AtlasColors.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: AtlasColors.line;
                    }

                    HorizontalLayout {
                        height: 42px;

                        Text {
                            text: "地図";
                            color: AtlasColors.ink;
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }

                        Text {
                            text: "Natural Earth · PD";
                            color: AtlasColors.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: AtlasColors.line;
                    }

                    HorizontalLayout {
                        height: 42px;

                        Text {
                            text: "日本語書体";
                            color: AtlasColors.ink;
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: transparent;
                        }

                        Text {
                            text: "Noto Sans JP · OFL";
                            color: AtlasColors.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            Rectangle {
                height: 10px;
                background: transparent;
            }

            ActionButton {
                label: "プライバシーポリシー";
                height: 48px;
                tapped => { root.screen = "privacy"; }
            }

            Rectangle {
                height: 8px;
                background: transparent;
            }

            ActionButton {
                label: "ライセンス";
                height: 48px;
                tapped => { root.screen = "licenses"; }
            }

            Rectangle {
                vertical-stretch: 1;
                background: transparent;
            }

            HorizontalLayout {
                alignment: center;

                AboutSlint {
                    width: 154px;
                    height: 40px;
                }
            }
        }
        if root.screen == "privacy" || root.screen == "licenses": VerticalLayout {
            padding: 20px;
            spacing: 0px;

            HorizontalLayout {
                height: 36px;

                BackButton {
                    label: "戻る";
                    tapped => { root.screen = "about"; }
                }
            }

            Rectangle {
                height: 18px;
                background: transparent;
            }

            ScrollView {
                width: 100%;
                vertical-stretch: 1;
                vertical-scrollbar-policy: ScrollBarPolicy.as-needed;
                mouse-drag-pan-enabled: true;

                VerticalLayout {
                    width: 100%;
                    padding-bottom: 20px;
                    spacing: 14px;

                    if root.screen == "privacy": Text {
                        text: root.privacy-text;
                        width: 100%;
                        color: AtlasColors.ink;
                        font-size: 14px;
                        wrap: word-wrap;
                    }

                    if root.screen == "licenses": Text {
                        text: "国旗アイコン · flag-icons · MIT License";
                        width: 100%;
                        color: AtlasColors.ink;
                        font-size: 16px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }

                    if root.screen == "licenses": Text {
                        text: root.flag-license-text;
                        width: 100%;
                        color: AtlasColors.ink;
                        font-size: 13px;
                        wrap: word-wrap;
                    }

                    if root.screen == "licenses": Text {
                        text: "日本語書体 · Noto Sans JP · SIL Open Font License 1.1";
                        width: 100%;
                        color: AtlasColors.ink;
                        font-size: 16px;
                        font-weight: 700;
                        wrap: word-wrap;
                    }

                    if root.screen == "licenses": Text {
                        text: root.font-license-text;
                        width: 100%;
                        color: AtlasColors.ink;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}
